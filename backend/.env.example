# Public HTTPS hostname pointed to this server.
MAI_DOMAIN=mai.example.com

# Server-only secrets. Never compile these into Android.
OPENAI_API_KEY=replace-with-server-openai-key
MAI_ADMIN_CODE=replace-with-long-random-admin-secret

# Auth/session defaults.
MAI_SESSION_TTL_SECONDS=900
MAI_ACTIVATION_TTL_SECONDS=86400

# MAI models.
MAI_STT_MODEL=gpt-transcribe
MAI_DIARIZE_MODEL=gpt-4o-transcribe-diarize
MAI_LIVE_STT_MODEL=gpt-live-transcribe
MAI_TRANSLATE_MODEL=gpt-5.6-terra
MAI_MOM_MODEL=gpt-5.6-sol

# Persistent/resumable processing.
MAI_JOB_DB=/data/mai-jobs.sqlite3
MAI_JOB_ROOT=/data/meetings
MAI_UPLOAD_CHUNK_BYTES=5242880
MAI_MAX_AUDIO_BYTES=209715200
MAI_JOB_WORKERS=2

# Backend audio is a processing cache, not a permanent archive.
# Ready jobs delete server audio automatically. Failed audio is retained for one day so a
# retry can reuse it; after that Android can resumably upload its preserved local copy again.
MAI_FAILED_AUDIO_CACHE_SECONDS=86400
MAI_STALE_UPLOAD_SECONDS=604800
MAI_JOB_CLEANUP_INTERVAL_SECONDS=300

# Accuracy: overlapping 7-minute chunks with independent retry/checkpointing.
MAI_SEGMENT_SECONDS=420
MAI_SEGMENT_OVERLAP_SECONDS=5
MAI_STT_WORKERS=3
MAI_DIARIZE_WORKERS=2
MAI_TRANSLATE_WORKERS=3
